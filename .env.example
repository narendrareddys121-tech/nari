# BidRush Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ─────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://bidrush:bidrush_dev_password@localhost:5432/bidrush_db?schema=public"
# Direct URL (required for Prisma Accelerate / connection pooling)
DIRECT_URL="postgresql://bidrush:bidrush_dev_password@localhost:5432/bidrush_db?schema=public"

# ─────────────────────────────────────────────────
# API SERVER
# ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS — set to your Next.js frontend URL
WEB_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Sign-In (optional; OAuth uses Google's account chooser)
# Configure the consent screen as External and publish it to allow every
# Google account. Do not add a domain restriction if personal accounts should
# be able to sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This uses the web app's same-origin API proxy. If the API has its own public
# hostname, set this to that hostname's /api/v1/auth/google/callback instead.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ─────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────
API_BASE_URL=http://localhost:4000/api/v1
# Browser requests use the Next.js same-origin proxy; do not expose the API URL.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ─────────────────────────────────────────────────
# CLOUDINARY (Image Uploads)
# Get these from: https://cloudinary.com/console
# ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────
# RAZORPAY (Payments — India)
# Get these from: https://dashboard.razorpay.com/
# Use TEST mode keys for development
# ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# ─────────────────────────────────────────────────
# EMAIL (Nodemailer / SMTP)
# For development without email: tokens printed to console
# ─────────────────────────────────────────────────
EMAIL_PROVIDER=console
# Set EMAIL_PROVIDER=smtp and fill these for real email:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@bidrush.in
