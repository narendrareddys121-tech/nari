{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "BidRush local host",
			"type": "shell",
			"command": "pnpm install --frozen-lockfile && pnpm dev",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BidRush dev server",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BidRush production build",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Clean and build BidRush",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Remove-Item -LiteralPath 'apps/web/.next' -Recurse -Force -ErrorAction SilentlyContinue; pnpm build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify BidRush build",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BidRush web localhost",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Remove-Item -LiteralPath 'apps/web/.next' -Recurse -Force -ErrorAction SilentlyContinue; pnpm --filter web dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BidRush tests",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "BidRush Google auth migration",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--filter",
				"api",
				"prisma",
				"migrate",
				"dev",
				"--name",
				"add_google_auth"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Apply Google auth migration",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"echo y|pnpm --filter api prisma migrate dev --name add_google_auth"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Generate Prisma client",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--filter",
				"api",
				"prisma",
				"generate"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect BidRush processes",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process -Filter \"name='node.exe'\" | Select-Object ProcessId,CommandLine | Format-List"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "List Node processes",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,Path,StartTime | Format-Table -AutoSize"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect Node commands",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process -Filter 'name = ''node.exe''' | Select-Object ProcessId,CommandLine | Format-List"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Stop stale BidRush processes",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"$ids=3920,4680,15384,19144,22644,26096; foreach ($id in $ids) { Stop-Process -Id $id -Force -ErrorAction SilentlyContinue }; Write-Output 'Stopped stale Node processes'"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Generate updated Prisma client",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--filter",
				"api",
				"prisma",
				"generate"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
